# Application
APP_NAME=BigchainDB Agri Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# BigchainDB
BIGCHAINDB_ROOT_URL=http://localhost:9984
BIGCHAINDB_WS_URL=ws://localhost:9985

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=bigchain

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=sensor_data
RABBITMQ_EXCHANGE=agri_exchange

# Authentication
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
